{
  "rewrites": [
    { "source": "/agendar", "destination": "/agendar.html" },
    { "source": "/api/vercel/notify", "destination": "/api/vercel/notify.js" },
    { "source": "/(.*)", "destination": "/relatorios.html" }
  ],
  "buildCommand": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
