{
  "rules": {
    "agendamentos": {
      ".read": true,
      ".write": "auth != null || (newData.hasChildren(['nome', 'tel', 'data', 'hora', 'status']) && newData.child('status').val() === 'Pendente' && newData.child('origem').val() === 'site' && !data.exists())",
      ".validate": "newData.hasChildren(['nome', 'tel', 'data', 'hora'])"
    },
    "registros": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "clientes": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "folgas": {
      ".read": true,
      ".write": "auth != null"
    },
    "espera": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
