{
  "rules": {
    "agendamentos": {
      ".read": "auth != null",
      "$key": {
        ".write": "auth != null || (!data.exists() && newData.hasChildren(['nome', 'tel', 'data', 'hora', 'status', 'origem']) && newData.child('status').val() === 'Pendente' && newData.child('origem').val() === 'site')",
        ".validate": "newData.hasChildren(['nome', 'tel', 'data', 'hora', 'status', 'origem'])"
      }
    },
    "horarios_ocupados": {
      ".read": true,
      ".write": true,
      ".validate": "newData.hasChildren(['data', 'hora']) && newData.child('data').val().matches(/^\\d{4}-\\d{2}-\\d{2}$/) && newData.child('hora').val().matches(/^\\d{2}:\\d{2}$/)"
    },
    "registros": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "clientes": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "folgas": {
      ".read": true,
      ".write": "auth != null"
    },
    "espera": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
