{
  "rules": {
    "agendamentos": {
      "$key": {
        ".read": true,
        ".write": "auth != null || (!data.exists() && newData.hasChildren(['nome', 'tel', 'data', 'hora']) && newData.child('status').val() === 'Pendente' && newData.child('origem').val() === 'site')",
        ".validate": "newData.hasChildren(['nome', 'tel', 'data', 'hora', 'status', 'origem'])"
      }
    },
    "registros": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "clientes": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "folgas": {
      ".read": true,
      ".write": "auth != null"
    },
    "espera": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
