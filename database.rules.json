{
  "rules": {
    "agendamentos": {
      ".read": true,
      ".write": true,
      ".validate": "newData.hasChildren(['nome', 'telefone', 'data', 'hora'])",
      "nome": {
        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
      },
      "telefone": {
        ".validate": "newData.isString() && newData.val().length >= 10 && newData.val().length <= 20"
      },
      "data": {
        ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)"
      },
      "hora": {
        ".validate": "newData.isString() && newData.val().matches(/^\\d{2}:\\d{2}$/)"
      },
      "$other": {
        ".validate": false
      }
    },
    "registros": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "clientes": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "folgas": {
      ".read": true,
      ".write": "auth != null"
    },
    "espera": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
